# 复制为服务器 .env 后按需配置；真实凭据不得提交到 Git、公开归档或截图中。
# 服务在容器内监听的端口；须与容器端口映射保持一致。
PORT=8765
# 服务监听地址；容器内通常使用 0.0.0.0，公网访问范围应由端口绑定和防火墙限制。
HOST=0.0.0.0
# Docker Compose 映射到宿主机的端口；直接通过服务器 IP 访问时使用此端口。
GITHUB_IMAGE_HOST_PORT=8765
# 网站对外访问的根地址；OAuth 登录请填写实际可访问的 HTTPS 根地址。
PUBLIC_BASE_URL=https://your-domain.example
# 必需的 GitHub OAuth App： https://github.com/settings/applications/new
# 创建应用后复制 Client ID，并生成 Client Secret；两项配置后点击登录进入授权，未配置时显示配置提示。
GITHUB_CLIENT_ID=
# 应用密钥只填服务器真实 .env，不得提交源码或归档。
GITHUB_CLIENT_SECRET=
# 授权范围为账号可访问的公开仓库，不限单仓库。
GITHUB_OAUTH_SCOPE=public_repo
# 留空时由 PUBLIC_BASE_URL 自动生成；示例：https://your-domain.example/api/auth/github/callback（请替换为实际部署域名）。
# 如显式填写，必须与 PUBLIC_BASE_URL 同源且路径严格为 /api/auth/github/callback。
GITHUB_OAUTH_REDIRECT_URI=
# 管理员的 GitHub 用户名（账号 login），不是数字 ID、昵称或邮箱；留空表示不指定管理员。
ADMIN_GITHUB_LOGIN=
# 允许访问的 GitHub 用户名，以英文逗号分隔；无持久化策略时留空允许所有已认证用户。
# 已保存的管理员访问策略优先于此初始配置；管理员账号始终可访问，留空不会清除已保存的限制。
ALLOWED_GITHUB_LOGINS=
# 是否允许删除仓库；保持 false。开启具有高风险，仍需用户的 OAuth 授权具备 GitHub 删除仓库权限。
ENABLE_REPO_DELETE=false

# 站点登录会话固定有效天数：默认 7；仅接受 1–30 的整数，使用网站不会续期。
SESSION_TTL_DAYS=7
